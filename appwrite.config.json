{
    "projectId": "6ab43a98000b9aedd03c",
    "projectName": "Shoebox",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "protocols": {
            "rest": true,
            "graphql": true,
            "websocket": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": true,
                "anonymous": true,
                "email-otp": true,
                "magic-url": true,
                "email-password": true
            },
            "security": {
                "duration": 31536000,
                "limit": null,
                "sessionsLimit": 10,
                "passwordHistory": null,
                "passwordDictionary": false,
                "personalDataCheck": false,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    },
    "functions": [
        {
            "$id": "gallery-api",
            "name": "Gallery API",
            "runtime": "bun-1.4",
            "path": "functions/gallery-api",
            "previewDomainTarget": "region",
            "previewDomainLabel": "shoebox-gallery-api",
            "entrypoint": "src/main.ts",
            "execute": [
                "any"
            ],
            "enabled": true,
            "logging": true,
            "events": [],
            "schedule": "",
            "timeout": 15,
            "commands": "bun install",
            "scopes": [
                "oauth2.introspect",
                "rows.read",
                "tables.read",
                "files.read",
                "buckets.read"
            ],
            "installationId": "",
            "providerRepositoryId": "",
            "providerBranch": "",
            "providerSilentMode": false,
            "providerRootDirectory": "",
            "providerBranches": [],
            "providerPaths": [],
            "buildSpecification": "s-2vcpu-2gb",
            "runtimeSpecification": "s-0.5vcpu-512mb",
            "deploymentRetention": 0
        }
    ],
    "sites": [
        {
            "$id": "shoebox",
            "name": "Shoebox",
            "path": ".",
            "framework": "astro",
            "logging": true,
            "timeout": 30,
            "buildRuntime": "node-22",
            "adapter": "static",
            "installCommand": "npm install",
            "buildCommand": "npm run build",
            "outputDirectory": "./dist",
            "fallbackFile": "",
            "installationId": "",
            "providerRepositoryId": "",
            "providerBranch": "",
            "providerSilentMode": false,
            "providerRootDirectory": "",
            "startCommand": "",
            "buildSpecification": "s-2vcpu-2gb",
            "runtimeSpecification": "s-0.5vcpu-512mb",
            "deploymentRetention": 0
        }
    ],
    "tablesDB": [
        {
            "$id": "shoebox",
            "name": "Shoebox",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "photos",
            "$permissions": [
                "create(\"users\")"
            ],
            "databaseId": "shoebox",
            "name": "Photos",
            "enabled": true,
            "rowSecurity": true,
            "columns": [
                {
                    "key": "fileId",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 64,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "galleryId",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 64,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "name",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 255,
                    "default": null,
                    "encrypt": false
                }
            ],
            "indexes": [
                {
                    "key": "galleryId_createdAt",
                    "type": "key",
                    "status": "available",
                    "columns": [
                        "galleryId",
                        "$createdAt"
                    ],
                    "orders": [
                        "ASC",
                        "DESC"
                    ]
                }
            ]
        },
        {
            "$id": "galleries",
            "$permissions": [
                "create(\"users\")"
            ],
            "databaseId": "shoebox",
            "name": "Galleries",
            "enabled": true,
            "rowSecurity": true,
            "columns": [
                {
                    "key": "name",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 128,
                    "default": null,
                    "encrypt": false
                }
            ],
            "indexes": []
        }
    ],
    "buckets": [
        {
            "$id": "photos",
            "$permissions": [
                "create(\"users\")"
            ],
            "fileSecurity": true,
            "name": "Photos",
            "enabled": true,
            "maximumFileSize": 5000000000,
            "allowedFileExtensions": [
                "jpg",
                "jpeg",
                "png",
                "gif",
                "webp",
                "heic",
                "heif",
                "avif"
            ],
            "compression": "none",
            "encryption": true,
            "antivirus": true
        }
    ]
}
